CREATE TABLE parcel (
    id TEXT NOT NULL PRIMARY KEY,
    tracking_number TEXT NOT NULL,
    carrier TEXT,
    detection_method TEXT,
    display_name TEXT NOT NULL,
    status TEXT NOT NULL,
    metadata_json TEXT,
    missing_metadata_json TEXT,
    last_checked_at TEXT,
    last_check_error TEXT,
    last_check_error_code TEXT,
    rate_limited_until TEXT,
    estimated_delivery_at TEXT,
    created_at TEXT NOT NULL,
    archived_at TEXT,
    latest_event_json TEXT
);

CREATE TABLE parcelEvent (
    id TEXT NOT NULL PRIMARY KEY,
    parcel_id TEXT NOT NULL REFERENCES parcel(id) ON DELETE CASCADE,
    occurred_at TEXT NOT NULL,
    status TEXT NOT NULL,
    description TEXT NOT NULL,
    location TEXT
);

CREATE INDEX parcelEvent_parcel_idx ON parcelEvent(parcel_id, occurred_at DESC);

CREATE TABLE notified_status (
    parcel_id TEXT NOT NULL REFERENCES parcel(id) ON DELETE CASCADE,
    status TEXT NOT NULL,
    PRIMARY KEY (parcel_id, status)
);

selectParcels:
SELECT * FROM parcel
WHERE archived_at IS NULL
ORDER BY created_at DESC;

selectAllParcels:
SELECT * FROM parcel
ORDER BY created_at DESC;

selectParcelById:
SELECT * FROM parcel
WHERE id = ?;

upsertParcel:
INSERT INTO parcel (id, tracking_number, carrier, detection_method, display_name, status, metadata_json, missing_metadata_json, last_checked_at, last_check_error, last_check_error_code, rate_limited_until, estimated_delivery_at, created_at, archived_at, latest_event_json)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    tracking_number = excluded.tracking_number,
    carrier = excluded.carrier,
    detection_method = excluded.detection_method,
    display_name = excluded.display_name,
    status = excluded.status,
    metadata_json = excluded.metadata_json,
    missing_metadata_json = excluded.missing_metadata_json,
    last_checked_at = excluded.last_checked_at,
    last_check_error = excluded.last_check_error,
    last_check_error_code = excluded.last_check_error_code,
    rate_limited_until = excluded.rate_limited_until,
    estimated_delivery_at = excluded.estimated_delivery_at,
    created_at = excluded.created_at,
    archived_at = excluded.archived_at,
    latest_event_json = excluded.latest_event_json;

deleteParcel:
DELETE FROM parcel
WHERE id = ?;

selectEventsByParcel:
SELECT * FROM parcelEvent
WHERE parcel_id = ?
ORDER BY occurred_at DESC;

upsertEvent:
INSERT INTO parcelEvent (id, parcel_id, occurred_at, status, description, location)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    parcel_id = excluded.parcel_id,
    occurred_at = excluded.occurred_at,
    status = excluded.status,
    description = excluded.description,
    location = excluded.location;

deleteEventsForParcel:
DELETE FROM parcelEvent
WHERE parcel_id = ?;

clearEvents:
DELETE FROM parcelEvent;

clearParcels:
DELETE FROM parcel;

selectNotifiedStatuses:
SELECT status FROM notified_status
WHERE parcel_id = ?;

insertNotifiedStatus:
INSERT OR IGNORE INTO notified_status (parcel_id, status)
VALUES (?, ?);

clearNotifiedStatuses:
DELETE FROM notified_status;
